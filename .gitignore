# Dependencies
node_modules/

# Build output / generated
dist/
out/
build/Release/
# NB: renderer/xterm-bundle.js IS committed (vendored) — a clone/build must have it or the
# renderer crashes (XtermBundle undefined). Regenerate with `npm run build:xterm` on xterm bumps.
*.dmg
*.zip
*.app

# Logs
*.log
npm-debug.log*

# Secrets & per-user config — NEVER commit (see ADR-002)
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision
secrets.json
*.secret

# macOS
.DS_Store

# Editor / tooling
.vscode/
.idea/

# Local scratch
.superpowers/

# Python bytecode
__pycache__/
*.pyc

# Jest coverage output (generated)
coverage/

# Local UI smoke harness: renderer/index.html with window.__TAURI__.core.invoke stubbed,
# so the real renderer stack can be driven in a browser. Generated, and NEVER committed —
# `frontendDist` is ../renderer, so anything left here ships inside the .dmg.
renderer/__smoke.html
